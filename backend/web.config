<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <!-- Reverse proxy all requests to local Node process on port 5000 -->
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Allow large uploads (adjust as needed) -->
        <requestLimits maxAllowedContentLength="2147483647" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <!-- Forward proxy headers to Express -->
        <add name="X-Forwarded-For" value="{REMOTE_ADDR}" />
        <add name="X-Forwarded-Proto" value="{HTTPS}" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>